# Enterprise AI Copilot - Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="Enterprise AI Copilot"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# ─── Server ───────────────────────────────────────────────────────────────────
HOST="0.0.0.0"
PORT=8000

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
# Run: ollama serve
# Pull model: ollama pull llama3.2
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3.2"
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
# Run: docker run -p 6333:6333 qdrant/qdrant
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="enterprise_knowledge"

# ─── Embedding Model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DEVICE="cpu"   # Use "cuda" for GPU acceleration

# ─── RAG Configuration ────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
